# Copy to Backend/.env and fill in. Backend/.env is gitignored.

# Required in production. In DEBUG mode an insecure fallback is used if unset.
# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=

DJANGO_DEBUG=true
# 10.0.2.2 is how the Android emulator reaches the host machine.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2

# Where the SQLite file lives. Relative paths resolve against Backend/.
DJANGO_DB_PATH=db.sqlite3

# Comma-separated origins allowed to call the API from a browser.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Face recognition -------------------------------------------------------
# Set to false to run the server without the (heavy) DeepFace/TensorFlow stack.
# Face enrolment and face-verified attendance then return 503 instead of
# silently letting anyone through.
FACE_RECOGNITION_ENABLED=true

# DeepFace model + detector. Facenet512 is a good accuracy/size tradeoff.
FACE_RECOGNITION_MODEL=Facenet512
FACE_DETECTOR_BACKEND=opencv

# Max cosine distance still considered a match. Lower = stricter.
# DeepFace's published default for Facenet512 + cosine is 0.30.
FACE_MATCH_THRESHOLD=0.30

# --- Attendance rules -------------------------------------------------------
# Default geofence radius (metres) applied to a new session.
DEFAULT_SESSION_RADIUS_M=100

# Refuse attendance when Android reports a mock location provider.
REJECT_MOCK_LOCATION=true

# Reject location fixes vaguer than this (metres, from Location.getAccuracy()).
# A coarse network fix can span a whole neighbourhood, which would otherwise
# satisfy the geofence from outside it.
MAX_LOCATION_ACCURACY_M=100

# Largest captured frame accepted, in bytes. A 720p JPEG is around 150 KB.
MAX_FACE_IMAGE_BYTES=8388608

# --- Device integrity (Android) ---------------------------------------------
# Opt-in, because it needs a Play Console app and a service account. Once on it
# fails closed: if the verifier cannot run, attendance is refused.
# Install with: pip install -r requirements-integrity.txt
DEVICE_INTEGRITY_REQUIRED=false
ANDROID_PACKAGE_NAME=
PLAY_INTEGRITY_CREDENTIALS=

# How long an attendance challenge nonce stays valid, in seconds.
INTEGRITY_NONCE_TTL_SECONDS=300
